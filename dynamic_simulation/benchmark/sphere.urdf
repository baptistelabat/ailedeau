<?xml version="1.0" ?>
<robot name="bob">
  <link name="link">
    <visual>
      <geometry>
        <sphere radius="0.1" />
      </geometry>
      <material name="material">
        <color rgba="1 0 0 1" /> <!-- Red color -->
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01" />
    </inertial>
  </link>
</robot>
